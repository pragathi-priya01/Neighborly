# Environment Configuration for Neighbourly Server
NODE_ENV=development
PORT=5000

# MongoDB Database Configuration:
# - MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/neighbourly?retryWrites=true&w=majority
# - Local MongoDB: mongodb://127.0.0.1:27017/neighbourly
# - Zero-config in-memory (dev only): leave blank
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/neighbourly?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

# Razorpay Configuration (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
RAZORPAY_MODE=test

# Cloudinary Configuration (Optional in dev; fallback used if absent)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Configuration (Optional: fallback heuristic NLP parser active when absent)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Transactional Email (Optional in dev)
RESEND_API_KEY=
EMAIL_FROM=notifications@neighbourly.local
